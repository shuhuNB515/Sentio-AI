# Sentio-AI 环境变量配置文件
# 复制此文件为 .env 并填入实际值

# === API 配置 ===
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1

# === 可选：自定义模型 ===
# VISION_MODEL=mimo-v2-omni
# CHAT_MODEL=mimo-v2-flash
# STT_MODEL=mimo-v2.5-asr
# TTS_MODEL=mimo-v2.5-tts
# TTS_VOICE=alloy

# === CORS ===
# CORS_ORIGINS=http://localhost:5173,https://shuhu.me,https://shuhuNB515.github.io

# === JWT ===
SECRET_KEY=your-secret-key-change-me
JWT_SECRET_KEY=your-jwt-secret-change-me

# === 成本控制参数 ===
# FRAME_SAMPLE_INTERVAL=5
# MAX_IMAGE_SIZE=512
# IMAGE_QUALITY=70
# MAX_CONVERSATION_HISTORY=10
# RATE_LIMIT_PER_MINUTE=20
