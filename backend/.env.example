# 环境变量配置文件
# 复制此文件为 .env 并填入实际值

OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：自定义模型
# VISION_MODEL=gpt-4o
# CHAT_MODEL=gpt-4o-mini
# STT_MODEL=whisper-1
# TTS_MODEL=tts-1
# TTS_VOICE=alloy

# 成本控制参数
# FRAME_SAMPLE_INTERVAL=5
# MAX_IMAGE_SIZE=512
# IMAGE_QUALITY=70
# MAX_CONVERSATION_HISTORY=10
# RATE_LIMIT_PER_MINUTE=20
